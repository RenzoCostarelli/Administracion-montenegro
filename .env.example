# En "true" muestra la landing "próximamente" en vez del sitio real.
# Sin definir (o cualquier otro valor) muestra el sitio real.
# COMING_SOON=false

# Access token del repositorio de Prismic.
# Generar en: https://<repo>.prismic.io/settings/api-keys
PRISMIC_ACCESS_TOKEN=

# Cuenta de Gmail que envía los emails del formulario de contacto.
# Requiere verificación en 2 pasos activada en esa cuenta.
GMAIL_USER=

# App password de esa cuenta de Gmail (NO la contraseña normal).
# Generar en: https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=

# Casilla donde llegan las consultas del formulario.
# Si se omite, se usa GMAIL_USER como destinatario.
CONTACT_TO_EMAIL=
