---
interface Props {
  title: string;
  subtitle: string;
}

const { title, subtitle } = Astro.props;
---

<section
  id="page-header"
  class="relative bg-mont-dark pt-32 pb-20 md:pt-44 md:pb-24 px-6 md:px-12 lg:px-20 overflow-hidden"
>
  <div
    class="absolute top-0 right-0 w-[55vw] h-[55vw] max-w-3xl max-h-3xl rounded-full bg-mont-blue opacity-[0.15] blur-[120px] pointer-events-none translate-x-1/3 -translate-y-1/3"
  >
  </div>

  <div id="page-header-content" class="relative z-10 container mx-auto flex flex-col gap-6">
    <a
      href="/"
      data-nav-link
      class="text-mont-sand text-xs tracking-[0.2em] uppercase font-sans hover:text-mont-cream transition-colors w-fit"
    >
      ← Inicio
    </a>
    <h1
      class="font-serif font-light text-mont-cream leading-[0.95] tracking-tight text-5xl md:text-6xl lg:text-7xl"
    >
      {title}
    </h1>
    <p class="text-mont-sand text-base md:text-lg leading-relaxed font-sans max-w-2xl">
      {subtitle}
    </p>
  </div>
</section>

<script>
  import { gsap } from "../../lib/gsap";

  gsap.set("#page-header-content", { opacity: 0, y: 24 });
  gsap.to("#page-header-content", {
    opacity: 1,
    y: 0,
    duration: 0.8,
    ease: "power3.out",
    delay: 0.15,
  });
</script>
