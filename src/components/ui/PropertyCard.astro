---
import "swiper/css";

interface Props {
  images?: string[];
  tag: string;
  title: string;
  description: string;
  price?: string;
  url: string;
}

const { images = [], tag, title, description, price, url } = Astro.props;
const hasImages = images.length > 0;
const hasMultiple = images.length > 1;
---

<div class="property-card group bg-mont-off-white flex flex-col relative">
  <a
    href={url}
    target="_blank"
    rel="noopener noreferrer"
    aria-label={title}
    class="absolute inset-0 z-0"
  ></a>

  <div class="property-carousel aspect-4/3 bg-mont-sand/50 relative overflow-hidden" data-url={url}>
    {
      !hasImages && (
        <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="32"
            height="32"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="text-mont-sand"
          >
            <rect x="3" y="3" width="18" height="18" rx="2" ry="2" />
            <circle cx="8.5" cy="8.5" r="1.5" />
            <polyline points="21 15 16 10 5 21" />
          </svg>
        </div>
      )
    }
    {
      hasImages && (
        <div class="swiper w-full h-full">
          <div class="swiper-wrapper">
            {images.map((image) => (
              <div class="swiper-slide">
                <img
                  src={image}
                  alt={title}
                  class="w-full h-full object-cover"
                  loading="lazy"
                  onerror="this.remove()"
                />
              </div>
            ))}
          </div>
        </div>
      )
    }
    <span
      class="z-10 absolute top-4 left-4 text-xs tracking-[0.2em] uppercase font-sans bg-mont-dark text-mont-cream px-3 py-1.5 pointer-events-none"
    >
      {tag}
    </span>
    {
      hasMultiple && (
        <>
          <button
            type="button"
            aria-label="Imagen anterior"
            class="carousel-prev z-10 absolute top-1/2 left-3 -translate-y-1/2 flex items-center justify-center w-8 h-8 bg-mont-dark text-mont-cream opacity-0 group-hover:opacity-100 focus-visible:opacity-100 transition-opacity"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="15 18 9 12 15 6" />
            </svg>
          </button>
          <button
            type="button"
            aria-label="Imagen siguiente"
            class="carousel-next z-10 absolute top-1/2 right-3 -translate-y-1/2 flex items-center justify-center w-8 h-8 bg-mont-dark text-mont-cream opacity-0 group-hover:opacity-100 focus-visible:opacity-100 transition-opacity"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="9 18 15 12 9 6" />
            </svg>
          </button>
          <div class="z-10 absolute bottom-3 inset-x-0 flex items-center justify-center gap-1.5">
            {images.map((_, i) => (
              <button
                type="button"
                aria-label={`Ir a la imagen ${i + 1}`}
                class:list={["carousel-dot w-1.5 h-1.5 rounded-full", i === 0 ? "bg-mont-cream" : "bg-mont-cream/40"]}
              />
            ))}
          </div>
        </>
      )
    }
  </div>
  <div class="p-6 flex flex-col gap-2 pointer-events-none">
    <h3 class="font-serif text-mont-dark text-lg leading-snug">{title}</h3>
    <p class="text-mont-dark-muted text-sm leading-relaxed font-sans">{description}</p>
    {price && <p class="font-serif text-mont-dark text-base pt-2">{price}</p>}
  </div>
</div>

<script>
  import Swiper from "swiper";

  document.querySelectorAll<HTMLElement>(".property-carousel").forEach((carousel) => {
    const swiperEl = carousel.querySelector<HTMLElement>(".swiper");
    if (!swiperEl) return;

    const url = carousel.dataset.url;
    const prevBtn = carousel.querySelector<HTMLButtonElement>(".carousel-prev");
    const nextBtn = carousel.querySelector<HTMLButtonElement>(".carousel-next");
    const dots = Array.from(carousel.querySelectorAll<HTMLButtonElement>(".carousel-dot"));
    const slideCount = swiperEl.querySelectorAll(".swiper-slide").length;

    const swiper = new Swiper(swiperEl, {
      loop: slideCount > 1,
      speed: 500,
      on: {
        slideChange(instance) {
          dots.forEach((dot, i) => {
            dot.classList.toggle("bg-mont-cream", i === instance.realIndex);
            dot.classList.toggle("bg-mont-cream/40", i !== instance.realIndex);
          });
        },
        click() {
          if (url) window.open(url, "_blank", "noopener,noreferrer");
        },
      },
    });

    prevBtn?.addEventListener("click", () => swiper.slidePrev());
    nextBtn?.addEventListener("click", () => swiper.slideNext());
    dots.forEach((dot, i) =>
      dot.addEventListener("click", () => (swiper.params.loop ? swiper.slideToLoop(i) : swiper.slideTo(i)))
    );
  });
</script>
