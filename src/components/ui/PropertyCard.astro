---
interface Props {
  image?: string;
  tag: string;
  title: string;
  description: string;
  price?: string;
}

const { image, tag, title, description, price } = Astro.props;
---

<div class="property-card bg-mont-off-white flex flex-col">
  <div class="aspect-[4/3] bg-mont-sand/50 relative overflow-hidden">
    <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="32"
        height="32"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="text-mont-sand"
      >
        <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
        <circle cx="8.5" cy="8.5" r="1.5"></circle>
        <polyline points="21 15 16 10 5 21"></polyline>
      </svg>
    </div>
    {
      image && (
        <img
          src={image}
          alt={title}
          class="absolute inset-0 w-full h-full object-cover"
          loading="lazy"
          onerror="this.remove()"
        />
      )
    }
    <span
      class="absolute top-4 left-4 text-xs tracking-[0.2em] uppercase font-sans bg-mont-dark text-mont-cream px-3 py-1.5"
    >
      {tag}
    </span>
  </div>
  <div class="p-6 flex flex-col gap-2">
    <h3 class="font-serif text-mont-dark text-lg leading-snug">{title}</h3>
    <p class="text-mont-dark-muted text-sm leading-relaxed font-sans">{description}</p>
    {price && <p class="font-serif text-mont-dark text-base pt-2">{price}</p>}
  </div>
</div>
