---
import Button from "../ui/Button.astro";

const data = {
  title: "¿Hablamos?",
  text: "Administración de consorcios, cambio de administrador, alquiler, venta o tasación.",
  email: "oficinaadmmontenegro@gmail.com",
  phone: "341-5278291",
  address: "Jujuy 2502, Rosario",
};
---

<section
  id="contacto"
  class="bg-mont-blue pt-28 md:pt-36 px-6 md:px-12 pb-10 lg:px-20"
>
  <div class="container mx-auto">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-24">
      <!-- Left: contact form -->
      <div class="flex flex-col gap-8">
        <div class="flex flex-col gap-4">
          <h2
            class="font-serif font-light text-mont-cream text-5xl md:text-6xl leading-none tracking-tight"
          >
            {data.title}
          </h2>
          <p
            class="text-mont-sand text-base md:text-lg leading-relaxed font-sans max-w-md"
          >
            {data.text}
          </p>
        </div>

        <form id="contact-form" class="flex flex-col gap-5 max-w-md" novalidate>
          <div class="flex flex-col gap-2">
            <label
              for="name"
              class="text-mont-sand text-xs tracking-[0.15em] uppercase font-sans"
            >
              Nombre
            </label>
            <input
              id="name"
              name="name"
              type="text"
              required
              class="bg-transparent border-b border-mont-cream/25 text-mont-cream placeholder:text-mont-sand py-2 font-sans focus:outline-none focus:border-mont-cream/70 transition-colors"
            />
          </div>

          <div class="flex flex-col gap-2">
            <label
              for="email"
              class="text-mont-sand text-xs tracking-[0.15em] uppercase font-sans"
            >
              Email
            </label>
            <input
              id="email"
              name="email"
              type="email"
              required
              class="bg-transparent border-b border-mont-cream/25 text-mont-cream placeholder:text-mont-sand py-2 font-sans focus:outline-none focus:border-mont-cream/70 transition-colors"
            />
          </div>

          <div class="flex flex-col gap-2">
            <label
              for="message"
              class="text-mont-sand text-xs tracking-[0.15em] uppercase font-sans"
            >
              Mensaje
            </label>
            <textarea
              id="message"
              name="message"
              rows="4"
              required
              class="bg-transparent border-b border-mont-cream/25 text-mont-cream placeholder:text-mont-sand py-2 font-sans resize-none focus:outline-none focus:border-mont-cream/70 transition-colors"
            ></textarea>
          </div>

          <p
            id="contact-form-status"
            class="text-mont-sand text-sm font-sans hidden"
          >
          </p>

          <div class="mt-2">
            <Button type="submit" variant="solid" tone="light"
              >Enviar consulta</Button
            >
          </div>
        </form>
      </div>

      <!-- Right: contact info -->
      <div class="flex flex-col gap-8 lg:pt-2">
        <div
          class="flex flex-col divide-y divide-mont-cream/10 border-t border-mont-cream/10"
        >
          <a
            href={`mailto:${data.email}`}
            class="group flex items-center justify-between py-6 hover:opacity-70 transition-opacity"
          >
            <div class="flex flex-col gap-1">
              <span
                class="text-mont-sand text-xs tracking-[0.2em] uppercase font-sans"
                >Email</span
              >
              <span class="text-mont-cream text-lg font-sans">{data.email}</span
              >
            </div>
          </a>

          <a
            href={`tel:${data.phone.replace(/[^0-9+]/g, "")}`}
            class="group flex items-center justify-between py-6 hover:opacity-70 transition-opacity"
          >
            <div class="flex flex-col gap-1">
              <span
                class="text-mont-sand text-xs tracking-[0.2em] uppercase font-sans"
                >Teléfono</span
              >
              <span class="text-mont-cream text-lg font-sans">{data.phone}</span
              >
            </div>
          </a>

          <div class="flex items-center justify-between py-6">
            <div class="flex flex-col gap-1">
              <span
                class="text-mont-sand text-xs tracking-[0.2em] uppercase font-sans"
                >Dirección</span
              >
              <span class="text-mont-cream text-lg font-sans"
                >{data.address}</span
              >
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Footer strip -->
    <div
      class="mt-12 pt-8 border-t border-mont-cream/10 flex flex-col md:flex-row items-start md:items-center justify-between gap-4 text-mont-sand text-xs font-sans tracking-wider"
    >
      <span>© {new Date().getFullYear()} Administración Montenegro</span>
      <span class="uppercase tracking-[0.2em]">Gestión que proyecta.</span>
    </div>
  </div>
</section>

<script is:inline define:vars={{ email: data.email }}>
  const form = document.getElementById("contact-form");
  const status = document.getElementById("contact-form-status");

  form?.addEventListener("submit", (e) => {
    e.preventDefault();

    if (!(form instanceof HTMLFormElement) || !form.checkValidity()) {
      form?.reportValidity();
      return;
    }

    const data = new FormData(form);
    const name = String(data.get("name") ?? "");
    const senderEmail = String(data.get("email") ?? "");
    const message = String(data.get("message") ?? "");

    const subject = encodeURIComponent(`Consulta desde el sitio web — ${name}`);
    const body = encodeURIComponent(`${message}\n\n— ${name} (${senderEmail})`);

    window.location.href = `mailto:${email}?subject=${subject}&body=${body}`;

    if (status) {
      status.textContent =
        "Se abrirá tu cliente de email para enviar la consulta.";
      status.classList.remove("hidden");
    }
  });
</script>
