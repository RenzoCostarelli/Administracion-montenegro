---
import PrismicRichText from "../PrismicRichText.astro";
import type { HomepageDiferenciales } from "../../types/homepage";

interface Props {
  data: HomepageDiferenciales;
}

const { data } = Astro.props;
---

<section
  id="diferenciales"
  class="bg-mont-dark py-28 md:py-36 px-6 md:px-12 lg:px-20"
>
  <div class="container mx-auto flex flex-col gap-8">
    <h2
      id="diferenciales-statement"
      class="font-serif font-semibold text-mont-cream text-pretty tracking-tight text-2xl md:text-3xl lg:text-4xl"
    >
      {data.tituloLinea1}<br />{data.tituloLinea2}
    </h2>
    <div id="diferenciales-body">
      <PrismicRichText
        field={data.texto}
        class="text-mont-sand text-base md:text-lg leading-relaxed text-balance font-sans max-w-2xl"
      />
    </div>
    {
      data.imagen.url && (
        <img
          id="diferenciales-image"
          src={data.imagen.url}
          alt={data.imagen.alt ?? ""}
          class="w-full h-auto rounded-2xl object-cover mt-4"
        />
      )
    }
  </div>
</section>

<script>
  import { gsap, ScrollTrigger } from "../../lib/gsap";

  gsap.set(
    ["#diferenciales-statement", "#diferenciales-body", "#diferenciales-image"],
    {
      opacity: 0,
      y: 30,
    },
  );

  const tl = gsap.timeline({ paused: true });
  tl.to("#diferenciales-statement", {
    opacity: 1,
    y: 0,
    duration: 0.8,
    ease: "power3.out",
  })
    .to(
      "#diferenciales-body",
      { opacity: 1, y: 0, duration: 0.7, ease: "power3.out" },
      "-=0.5",
    )
    .to(
      "#diferenciales-image",
      { opacity: 1, y: 0, duration: 0.7, ease: "power3.out" },
      "-=0.4",
    );

  ScrollTrigger.create({
    trigger: "#diferenciales",
    start: "top 75%",
    animation: tl,
    scrub: false,
    once: true,
  });
</script>
