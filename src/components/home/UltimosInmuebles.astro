---
import { asLink } from "@prismicio/client";
import SectionTitle from "../ui/SectionTitle.astro";
import Button from "../ui/Button.astro";
import PropertyCard from "../ui/PropertyCard.astro";
import type { HomepageInmuebles } from "../../types/homepage";

interface Props {
  data: HomepageInmuebles;
}

const { data } = Astro.props;
const ctaVentaHref = asLink(data.ctaVenta.link) ?? "/venta";
const ctaAlquilerHref = asLink(data.ctaAlquiler.link) ?? "/alquileres";
---

<section id="inmuebles" class="bg-white py-28 md:py-36 px-6 md:px-12 lg:px-20">
  <div class="container mx-auto">
    <div
      class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-14"
    >
      <SectionTitle title={data.titulo} subtitle={data.subtitulo} />
    </div>

    <div
      id="inmuebles-cards"
      class="grid grid-cols-1 md:grid-cols-3 gap-1 bg-mont-sand"
    >
      {
        data.propiedadesDestacadas.map((propiedad) => (
          <PropertyCard propiedad={propiedad} />
        ))
      }
    </div>

    <div class="mt-12 space-x-2">
      <Button href={ctaVentaHref} variant="solid" tone="dark">
        {data.ctaVenta.label}
      </Button>
      <Button href={ctaAlquilerHref} variant="solid" tone="dark">
        {data.ctaAlquiler.label}
      </Button>
    </div>
  </div>
</section>

<script>
  import { gsap, ScrollTrigger } from "../../lib/gsap";

  const cards = document.querySelectorAll("#inmuebles-cards > *");
  gsap.set(cards, { opacity: 0, y: 40 });

  const cardsTl = gsap.timeline({ paused: true });
  cardsTl.to(cards, {
    opacity: 1,
    y: 0,
    duration: 0.7,
    ease: "power3.out",
    stagger: 0.12,
  });

  ScrollTrigger.create({
    trigger: "#inmuebles-cards",
    start: "top 82%",
    animation: cardsTl,
    scrub: false,
    once: true,
  });
</script>
