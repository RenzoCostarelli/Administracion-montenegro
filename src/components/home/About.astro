---
const data = {
  title: "Una marca. Dos áreas.\nUna misma forma de trabajar.",
  body: "Hay decisiones que resuelven el presente. Y hay decisiones que también construyen lo que viene. Conocer, ordenar, anticipar y decidir con criterio: esa es la idea detrás de una gestión que proyecta.",
  areas: [
    {
      name: "Administración de consorcios",
      tagline: "Cada peso, explicado.",
      description:
        "Expensas que se entienden, gastos respaldados y una gestión que hace visible qué pasa, por qué y cómo se resuelve.",
    },
    {
      name: "Montenegro Inmobiliaria",
      tagline: "Conocer más para decidir mejor.",
      description:
        "Alquiler, venta y tasación con acompañamiento profesional y una experiencia simple en cada etapa.",
    },
  ],
};
---

<section
  id="about"
  class="bg-mont-off-white py-28 md:py-36 px-6 md:px-12 lg:px-20"
>
  <div
    class="container mx-auto grid grid-cols-1 lg:grid-cols-2 gap-14 lg:gap-24 items-center"
  >
    <!-- Image -->
    <div
      id="about-image"
      class="aspect-[4/5] bg-mont-sand/50 relative overflow-hidden order-2 lg:order-1"
    >
      <div
        class="absolute inset-0 flex items-center justify-center pointer-events-none"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="48"
          height="48"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="text-mont-sand"
        >
          <path d="M3 21h18"></path>
          <path d="M5 21V7l8-4v18"></path>
          <path d="M19 21V11l-6-4"></path>
        </svg>
      </div>
      <!-- Photo — drop a file at public/images/about.jpg to replace this placeholder -->
      <img
        src="/images/about.jpg"
        alt="Equipo de Administración Montenegro"
        class="absolute inset-0 w-full h-full object-cover"
        loading="lazy"
        onerror="this.remove()"
      />
    </div>

    <!-- Text -->
    <div id="about-text" class="flex flex-col gap-8 order-1 lg:order-2">
      <h2
        class="font-serif font-light text-mont-dark text-balance leading-none tracking-tight text-4xl md:text-5xl whitespace-pre-line"
      >
        {data.title}
      </h2>
      <p
        class="text-mont-dark-muted text-base md:text-lg leading-relaxed font-sans max-w-md"
      >
        {data.body}
      </p>

      <div
        class="flex flex-col divide-y divide-mont-sand border-t border-mont-sand mt-2"
      >
        {
          data.areas.map((area) => (
            <div class="py-6 flex flex-col gap-1">
              <div class="flex items-baseline justify-between gap-4">
                <h3 class="font-serif text-mont-dark text-xl">{area.name}</h3>
              </div>
              <p class="font-serif italic text-mont-dark text-base leading-snug">
                {area.tagline}
              </p>
              <p class="text-mont-dark-muted text-sm leading-relaxed font-sans">
                {area.description}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap, ScrollTrigger } from "../../lib/gsap";

  gsap.set(["#about-image", "#about-text"], { opacity: 0, y: 30 });

  const tl = gsap.timeline({ paused: true });
  tl.to("#about-image", {
    opacity: 1,
    y: 0,
    duration: 0.8,
    ease: "power3.out",
  }).to(
    "#about-text",
    { opacity: 1, y: 0, duration: 0.8, ease: "power3.out" },
    "-=0.6",
  );

  ScrollTrigger.create({
    trigger: "#about",
    start: "top 75%",
    animation: tl,
    scrub: false,
    once: true,
  });
</script>
