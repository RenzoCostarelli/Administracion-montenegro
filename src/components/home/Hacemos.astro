---
import SectionTitle from "../ui/SectionTitle.astro";
import Button from "../ui/Button.astro";

const data = {
  title: "Más simple de lo que parece.",
  subtitle:
    "Un proceso ordenado para cambiar de gestión sin perder continuidad ni información.",
  steps: [
    {
      number: "01",
      name: "Diagnóstico",
      description: "Revisamos la situación actual.",
    },
    {
      number: "02",
      name: "Propuesta",
      description: "Definimos alcance y herramientas.",
    },
    {
      number: "03",
      name: "Traspaso",
      description: "Acompañamos documentación y cambio.",
    },
    {
      number: "04",
      name: "Inicio",
      description: "Ponemos en marcha la nueva administración.",
    },
  ],
  cta: { label: "Pedir presupuesto", href: "/#contacto" },
};
---

<section
  id="hacemos"
  class="bg-mont-blue py-28 md:py-36 px-6 md:px-12 lg:px-20"
>
  <div class="container mx-auto flex flex-col gap-14">
    <div id="hacemos-text">
      <SectionTitle title={data.title} subtitle={data.subtitle} tone="light" />
    </div>

    <div
      id="hacemos-steps"
      class="relative flex flex-col gap-10 md:gap-12 border-t border-mont-cream/20 pt-12 md:pt-14"
    >
      <div
        class="absolute left-0 top-0 bottom-0 w-px bg-mont-cream/20"
        aria-hidden="true"
      >
      </div>
      <div
        id="hacemos-line-fill"
        class="absolute left-0 top-0 bottom-1 w-px origin-top bg-mont-sand"
        aria-hidden="true"
      >
      </div>
      {
        data.steps.map((step) => (
          <div class="hacemos-step relative pl-8 md:pl-10 flex flex-col sm:flex-row gap-6 sm:items-center">
            <span class="absolute left-0 bottom-0 -translate-x-1/2 w-2.5 h-2.5 rounded-full bg-mont-sand" />
            <div class="w-20 h-20 md:w-24 md:h-24 shrink-0 bg-mont-cream/10 border border-mont-cream/20 relative overflow-hidden">
              <div class="absolute inset-0 flex items-center justify-center pointer-events-none text-neutral-50">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="28"
                  height="28"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="0"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="text-mont-sand"
                >
                  <path d="M3 21h18" />
                  <path d="M5 21V7l8-4v18" />
                  <path d="M19 21V11l-6-4" />
                </svg>
              </div>
              <img
                src={`/images/hacemos-${step.number}.jpg`}
                alt={step.name}
                class="absolute inset-0 w-full h-full object-cover"
                loading="lazy"
                onerror="this.remove()"
              />
            </div>
            <div>
              <span class="text-neutral-50 text-sm tracking-[0.2em] font-sans">
                {step.number}
              </span>
              <h3 class="font-serif text-neutral-50 text-2xl mt-2">
                {step.name}
              </h3>
              <p class="text-neutral-50 leading-relaxed font-sans mt-2 max-w-sm">
                {step.description}
              </p>
            </div>
          </div>
        ))
      }
    </div>

    <div id="hacemos-cta">
      <Button
        href={data.cta.href}
        variant="solid"
        tone="light"
        id="hacemos-cta-button"
      >
        {data.cta.label}
      </Button>
    </div>
  </div>
</section>

<script>
  import { gsap, ScrollTrigger } from "../../lib/gsap";
  import { getLenis } from "../../lib/lenis";

  gsap.set(["#hacemos-text", "#hacemos-cta"], { opacity: 0, y: 30 });
  gsap.set(".hacemos-step", { opacity: 0, y: 30 });
  gsap.set("#hacemos-line-fill", { scaleY: 0 });
  const cta = document.getElementById("hacemos-cta-button")!;

  const tl = gsap.timeline({ paused: true });
  tl.to("#hacemos-text", {
    opacity: 1,
    y: 0,
    duration: 0.8,
    ease: "power3.out",
  })
    .to(
      ".hacemos-step",
      { opacity: 1, y: 0, duration: 0.7, ease: "power3.out", stagger: 0.1 },
      "-=0.5",
    )
    .to(
      "#hacemos-cta",
      { opacity: 1, y: 0, duration: 0.6, ease: "power3.out" },
      "-=0.3",
    );

  ScrollTrigger.create({
    trigger: "#hacemos",
    start: "top 75%",
    animation: tl,
    scrub: false,
    once: true,
  });

  const lineTl = gsap.timeline({ paused: true });
  lineTl.to("#hacemos-line-fill", { scaleY: 1, ease: "none" });

  ScrollTrigger.create({
    trigger: "#hacemos-steps",
    start: "top 80%",
    end: "bottom 80%",
    // markers: true,
    animation: lineTl,
    scrub: true,
  });

  cta.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", (e) => {
      const href = link.getAttribute("href") ?? "";
      const hash = href.includes("#") ? href.split("#")[1] : null;
      if (!hash) return;
      const target = document.getElementById(hash);
      if (!target) return;
      e.preventDefault();
      getLenis()?.scrollTo(target, { offset: -80 });
    });
  });
</script>
