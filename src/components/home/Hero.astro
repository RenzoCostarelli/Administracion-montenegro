---
import { asLink } from "@prismicio/client";
import Button from "../ui/Button.astro";
import PrismicRichText from "../PrismicRichText.astro";
import type { HomepageHero } from "../../types/homepage";

interface Props {
  data: HomepageHero;
}

const { data } = Astro.props;
const videoUrl = asLink(data.videoFondo);
const ctaPrincipalHref = asLink(data.ctaPrincipal.link) ?? "#";
const ctaSecundarioHref = asLink(data.ctaSecundario.link) ?? "#";
---

<section
  id="hero"
  class="relative bg-mont-dark pt-42 pb-20 md:pt-64 md:pb-28 px-6 md:px-12 lg:px-20 overflow-hidden"
>
  {
    videoUrl && (
      <video
        id="hero-video"
        class="absolute inset-0 w-full h-full object-cover object-top"
        autoplay
        muted
        loop
        playsinline
        preload="auto"
      >
        <source src={videoUrl} type="video/mp4" />
      </video>
    )
  }
  <div
    class="absolute inset-0 bg-linear-to-r from-neutral-900/70 to-transparent pointer-events-none"
  >
  </div>

  <div
    class="absolute top-0 right-0 w-[55vw] h-[55vw] max-h-3xl rounded-full bg-mont-blue opacity-[0.06] blur-[120px] pointer-events-none translate-x-1/3 -translate-y-1/3"
  >
  </div>

  <div
    id="hero-content"
    class="px-6 md:px-10 relative z-10 container mx-auto flex-col justify-start gap-8"
  >
    <div id="hero-title" class="overflow-hidden">
      <h1
        class="block font-serif font-semibold pb-2 text-mont-cream leading-none tracking-tight text-[12vw] md:text-[5vw] lg:text-[4.5vw] 2xl:text-[2.5vw]"
      >
        {data.titulo}
      </h1>
    </div>

    <div id="hero-body" class="flex flex-col gap-8 max-w-2xl">
      <PrismicRichText
        field={data.texto}
        class="text-mont-sand text-balance text-base md:text-lg leading-relaxed font-sans"
      />

      <div id="hero-cta" class="flex flex-wrap gap-4">
        <Button href={ctaPrincipalHref} variant="solid" tone="accent">
          {data.ctaPrincipal.label}
        </Button>
        <Button href={ctaSecundarioHref} variant="outline" tone="light">
          {data.ctaSecundario.label}
        </Button>
      </div>
    </div>
  </div>
</section>

<section id="hero-philosophy" class="bg-mont-blue py-12 px-6 md:px-10">
  <div
    id="hero-philosophy-content"
    class="container mx-auto flex flex-col justify-start gap-8"
  >
    <div class="flex flex-col gap-1">
      <p
        class="font-serif font-semibold text-white leading-none tracking-tight text-3xl md:text-4xl"
      >
        {data.filosofiaLinea1}
      </p>
      <p
        class="font-serif font-semibold text-white leading-none tracking-tight text-3xl md:text-4xl"
      >
        {data.filosofiaLinea2}
      </p>
    </div>

    <PrismicRichText
      field={data.filosofiaTexto}
      class="text-white text-base md:text-lg leading-relaxed font-sans pt-6"
    />
  </div>
</section>

<script>
  import { gsap, ScrollTrigger, SplitText } from "../../lib/gsap";
  import { getLenis } from "../../lib/lenis";

  const section = document.getElementById("hero")!;
  const content = document.getElementById("hero-content")!;
  const titleEl = document.getElementById("hero-title")!;
  const body = document.getElementById("hero-body")!;
  const cta = document.getElementById("hero-cta")!;

  // Split headline lines into words for staggered reveal
  const split = new SplitText(titleEl, { type: "words" });

  // Set initial hidden state
  gsap.set(body, { opacity: 0, y: 16 });
  gsap.set(split.words, { opacity: 0, yPercent: 100 });

  // Entrance timeline (plays on load)
  const entrance = gsap.timeline({ delay: 0.15 });
  entrance
    .to(split.words, {
      opacity: 1,
      yPercent: 0,
      duration: 0.9,
      ease: "power3.out",
      stagger: 0.05,
    })
    .to(body, { opacity: 1, y: 0, duration: 0.7, ease: "power2.out" }, "-=0.4");

  // Smooth scroll CTA links
  cta.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", (e) => {
      const href = link.getAttribute("href") ?? "";
      const hash = href.includes("#") ? href.split("#")[1] : null;
      if (!hash) return;
      const target = document.getElementById(hash);
      if (!target) return;
      e.preventDefault();
      getLenis()?.scrollTo(target, { offset: -80 });
    });
  });

  // Scroll exit: content drifts upward
  const exitTl = gsap.timeline({ paused: true });
  exitTl.to(content, { y: -100, opacity: 0, ease: "none" });

  ScrollTrigger.create({
    trigger: section,
    start: "top top",
    end: "bottom top",
    animation: exitTl,
    scrub: true,
  });

  // Philosophy section: reveal on scroll
  const philosophyContent = document.getElementById("hero-philosophy-content")!;
  gsap.set(philosophyContent, { opacity: 0, y: 30 });

  const philosophyTl = gsap.timeline({ paused: true });
  philosophyTl.to(philosophyContent, {
    opacity: 1,
    y: 0,
    duration: 0.8,
    ease: "power3.out",
  });

  ScrollTrigger.create({
    trigger: "#hero-philosophy",
    start: "top 75%",
    animation: philosophyTl,
    scrub: false,
    once: true,
  });
</script>
