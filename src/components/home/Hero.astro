---
import Button from "../ui/Button.astro";

const data = {
  headline: ["Gestión", "que proyecta."],
  text: "Administramos consorcios y acompañamos decisiones inmobiliarias con información clara, seguimiento, experiencia y criterio.",
  ctaPrimary: { label: "Conocer servicios", href: "/#about" },
  ctaSecondary: { label: "Hablemos", href: "/#contacto" },
  philosophyTitle: ["Gestionar el presente.", "Proyectar lo que viene."],
  philosophyBody:
    "Claridad para gestionar. Información para decidir. Experiencia para proyectar.",
};
---

<section
  id="hero"
  class="relative bg-mont-dark pt-32 pb-20 md:pt-44 md:pb-28 px-6 md:px-12 lg:px-20 overflow-hidden"
>
  <video
    id="hero-video"
    class="absolute inset-0 w-full h-full object-cover"
    autoplay
    muted
    loop
    playsinline
    preload="auto"
  >
    <source
      src="https://res.cloudinary.com/dztzomvin/video/upload/v1789404592/17725088_xjr2e1.mp4"
      type="video/mp4"
    />
  </video>
  <div
    class="absolute inset-0 bg-linear-to-t from-neutral-900/70 to-transparent pointer-events-none"
  >
  </div>

  <div
    class="absolute top-0 right-0 w-[55vw] h-[55vw] max-w-3xl max-h-3xl rounded-full bg-mont-blue opacity-[0.06] blur-[120px] pointer-events-none translate-x-1/3 -translate-y-1/3"
  >
  </div>

  <div
    id="hero-content"
    class="px-6 md:px-10 relative z-10 container mx-autoflex flex-col justify-start gap-8 max-w-3xl"
  >
    <div id="hero-title" class="overflow-hidden">
      {
        data.headline.map((line) => (
          <p class="block font-serif font-semibold pb-2 text-mont-cream leading-none tracking-tight text-[12vw] md:text-[4vw] lg:text-[4.5vw]">
            {line}
          </p>
        ))
      }
    </div>

    <div id="hero-body" class="flex flex-col gap-8 max-w-xl">
      <p class="text-mont-sand text-base md:text-lg leading-relaxed font-sans">
        {data.text}
      </p>

      <div id="hero-cta" class="flex flex-wrap gap-4">
        <Button href={data.ctaPrimary.href} variant="solid" tone="accent">
          {data.ctaPrimary.label}
        </Button>
        <Button href={data.ctaSecondary.href} variant="outline" tone="light">
          {data.ctaSecondary.label}
        </Button>
      </div>
    </div>
  </div>
</section>

<section id="hero-philosophy" class="bg-mont-blue py-2 md:py-12 px-6 md:px-10">
  <div
    id="hero-philosophy-content"
    class="container mx-auto flex flex-col justify-start gap-8"
  >
    <div class="flex flex-col gap-1">
      {
        data.philosophyTitle.map((line) => (
          <p class="font-serif font-light text-white leading-tight tracking-tight text-3xl md:text-4xl">
            {line}
          </p>
        ))
      }
    </div>

    <p
      class="text-white text-base md:text-lg leading-relaxed font-sans border-t border-white/20 pt-6"
    >
      {data.philosophyBody}
    </p>
  </div>
</section>

<script>
  import { gsap, ScrollTrigger, SplitText } from "../../lib/gsap";
  import { getLenis } from "../../lib/lenis";

  const section = document.getElementById("hero")!;
  const content = document.getElementById("hero-content")!;
  const titleEl = document.getElementById("hero-title")!;
  const body = document.getElementById("hero-body")!;
  const cta = document.getElementById("hero-cta")!;

  // Split headline lines into words for staggered reveal
  const split = new SplitText(titleEl, { type: "words" });

  // Set initial hidden state
  gsap.set(body, { opacity: 0, y: 16 });
  gsap.set(split.words, { opacity: 0, yPercent: 100 });

  // Entrance timeline (plays on load)
  const entrance = gsap.timeline({ delay: 0.15 });
  entrance
    .to(split.words, {
      opacity: 1,
      yPercent: 0,
      duration: 0.9,
      ease: "power3.out",
      stagger: 0.05,
    })
    .to(body, { opacity: 1, y: 0, duration: 0.7, ease: "power2.out" }, "-=0.4");

  // Smooth scroll CTA links
  cta.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", (e) => {
      const href = link.getAttribute("href") ?? "";
      const hash = href.includes("#") ? href.split("#")[1] : null;
      if (!hash) return;
      const target = document.getElementById(hash);
      if (!target) return;
      e.preventDefault();
      getLenis()?.scrollTo(target, { offset: -80 });
    });
  });

  // Scroll exit: content drifts upward
  const exitTl = gsap.timeline({ paused: true });
  exitTl.to(content, { y: -100, opacity: 0, ease: "none" });

  ScrollTrigger.create({
    trigger: section,
    start: "top top",
    end: "bottom top",
    animation: exitTl,
    scrub: true,
  });

  // Philosophy section: reveal on scroll
  const philosophyContent = document.getElementById("hero-philosophy-content")!;
  gsap.set(philosophyContent, { opacity: 0, y: 30 });

  const philosophyTl = gsap.timeline({ paused: true });
  philosophyTl.to(philosophyContent, {
    opacity: 1,
    y: 0,
    duration: 0.8,
    ease: "power3.out",
  });

  ScrollTrigger.create({
    trigger: "#hero-philosophy",
    start: "top 75%",
    animation: philosophyTl,
    scrub: false,
    once: true,
  });
</script>
