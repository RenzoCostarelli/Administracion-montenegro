---
import type { RichTextField, ImageField, LinkField } from "@prismicio/client";
import { isFilled } from "@prismicio/client";
import PrismicRichText from "./PrismicRichText.astro";

interface Props {
  shortText: RichTextField;
  title: RichTextField;
  text: RichTextField;
  backgroundImage: ImageField;
  bgVideo: LinkField;
  ctaText: string;
}

const { shortText, title, text, backgroundImage, bgVideo, ctaText } =
  Astro.props;
---

<section
  id="hero-section"
  class="min-h-[calc(100vh-72px)] flex items-center bg-mont-blue relative"
>
  <div class="absolute h-full w-full inset-0">
    {
      isFilled.link(bgVideo) && (
        <video
          src={bgVideo.url}
          autoplay
          muted
          loop
          playsinline
          class="w-full h-full object-cover object-center opacity-50"
        />
      )
    }
    {
      !isFilled.link(bgVideo) && backgroundImage.url && (
        <img
          src={backgroundImage.url}
          alt={backgroundImage.alt ?? ""}
          aria-hidden="true"
          class="w-full h-full object-cover object-center opacity-50"
        />
      )
    }
  </div>

  <div
    id="hero-content"
    class="w-full h-full max-w-5xl mx-auto flex flex-col gap-3 items-start justify-center px-14 py-20 relative"
  >
    <PrismicRichText
      field={shortText}
      class="md:text-[1.125rem] font-serif text-mont-dark text-balance"
    />

    <div id="hero-title">
      <PrismicRichText
        field={title}
        class="md:text-[1.3125rem] font-serif text-mont-dark text-balance"
      />
    </div>
    <div id="hero-text">
      <PrismicRichText
        field={text}
        class="text-sm md:text-[1rem] text-mont-dark text-balance"
      />
    </div>

    <div id="hero-cta" class="mt-10">
      <a
        href="/#servicios"
        class="inline-flex items-center gap-3 border border-neutral-950 text-xs tracking-widest uppercase px-8 py-4 bg-mont-dark text-mont-cream hover:text-neutral-950 hover:bg-neutral-50 duration-400 hover:border-neutral-50 transition-colors rounded-full"
      >
        {ctaText}
      </a>
    </div>
  </div>
</section>

<script>
  import { gsap, ScrollTrigger, SplitText } from "../lib/gsap";
  import { getLenis } from "../lib/lenis";

  const section = document.getElementById("hero-section")!;
  const content = document.getElementById("hero-content")!;
  const titleEl = document.getElementById("hero-title")!;
  const textEl = document.getElementById("hero-text")!;
  const ctaEl = document.getElementById("hero-cta")!;

  // Split title into words for entrance animation
  const split = new SplitText(titleEl, { type: "words" });

  // Set initial hidden state immediately (avoids CSS transition interference)
  gsap.set([textEl, ctaEl], { opacity: 0, filter: "blur(3px)" });

  // Entrance animation (plays on load)
  const entranceTl = gsap.timeline({ delay: 0.1 });
  entranceTl
    .from(split.words, {
      opacity: 0,
      filter: "blur(6px)",
      stagger: 0.07,
      duration: 0.8,
      ease: "power3.out",
    })
    .to(textEl, { opacity: 1, filter: "blur(0px)", duration: 0.7 }, "-=0.4")
    .to(ctaEl, { opacity: 1, filter: "blur(0px)", duration: 0.6 }, "-=0.3");

  // CTA smooth scroll
  const ctaLink = ctaEl.querySelector("a");
  ctaLink?.addEventListener("click", (e) => {
    const href = ctaLink.getAttribute("href");
    if (!href) return;
    const hash = href.includes("#") ? href.split("#")[1] : null;
    if (!hash) return;
    const target = document.getElementById(hash);
    if (!target) return;
    e.preventDefault();
    getLenis()?.scrollTo(target, { offset: -80 });
  });

  // Scroll exit animation
  const exitTl = gsap.timeline({ paused: true });
  exitTl.to(content, {
    y: -80,
    opacity: 0,
    ease: "none",
  });

  ScrollTrigger.create({
    trigger: section,
    start: "top top",
    end: "bottom top",
    animation: exitTl,
    scrub: true,
  });
</script>
