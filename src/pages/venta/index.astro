---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import PageHeader from "../../components/ui/PageHeader.astro";
import PropertyGrid from "../../components/ui/PropertyGrid.astro";
import Contacto from "../../components/home/Contacto.astro";
import type { Property } from "../../types/property";

const properties: Property[] = [
  {
    tag: "VENTA",
    title: "Departamento 1 dormitorio — Pichincha",
    description: "54 m², planta funcional y excelente luz natural.",
    price: "USD 78.000",
  },
  {
    tag: "VENTA",
    title: "PH 2 dormitorios — Alberdi",
    description: "85 m², patio y terraza, a refaccionar.",
    price: "USD 92.000",
  },
  {
    tag: "VENTA",
    title: "Local comercial — Zona Sur",
    description: "90 m², esquina, alto tránsito peatonal.",
    price: "USD 130.000",
  },
  {
    tag: "VENTA",
    title: "Departamento 2 dormitorios — Puerto Norte",
    description: "78 m², balcón terraza con vista al río, cochera incluida.",
    price: "USD 145.000",
  },
  {
    tag: "VENTA",
    title: "Semipiso 3 dormitorios — Centro",
    description: "128 m², espacios generosos y arquitectura contemporánea.",
    price: "USD 195.000",
  },
  {
    tag: "VENTA",
    title: "Casa 3 dormitorios — Fisherton",
    description: "210 m² cubiertos, jardín y quincho, cochera doble.",
    price: "USD 260.000",
  },
];
---

<Layout title="En venta — Administración Montenegro">
  <Navbar />
  <main>
    <PageHeader
      title="En venta"
      subtitle="Propiedades en venta con información completa para decidir con criterio."
    />

    <section class="bg-white py-28 md:py-36 px-6 md:px-12 lg:px-20">
      <div class="container mx-auto">
        <PropertyGrid properties={properties} />
      </div>
    </section>

    <Contacto />
  </main>
</Layout>
