---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import PageHeader from "../../components/ui/PageHeader.astro";
import PropertyGrid from "../../components/ui/PropertyGrid.astro";
import Contacto from "../../components/home/Contacto.astro";
import { getPropiedades } from "../../lib/getPropiedades";
import { getHomepage } from "../../lib/getHomepage";

const [propiedades, homepage] = await Promise.all([getPropiedades(), getHomepage()]);
const properties = propiedades.filter((propiedad) => propiedad.disponibleAlquiler);
---

<Layout title="Alquileres — Administración Montenegro">
  <Navbar />
  <main>
    <PageHeader title="Alquileres" />

    <section class="bg-white py-28 md:py-36 px-6 md:px-12 lg:px-20">
      <div class="container mx-auto">
        <PropertyGrid properties={properties} />
      </div>
    </section>

    <Contacto data={homepage.contacto} />
  </main>
</Layout>
